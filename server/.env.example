# ---- Server ----
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nifty_paper_trader
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ---- Market data ----
# mock   = simulated prices (works any time, clearly labelled SIMULATED in the UI)
# upstox = live Upstox Market Data Feed V3
MARKET_DATA_PROVIDER=mock
# Reject orders outside 09:15-15:30 IST and auto square-off at 15:15. Defaults to true for live
# providers and false for mock, so you can practise when NSE is closed.
# ENFORCE_MARKET_HOURS=true
# NSE trading holidays (YYYY-MM-DD, comma separated). Copy from NSE's holiday circular each year.
NSE_HOLIDAYS=

# ---- Upstox (only when MARKET_DATA_PROVIDER=upstox) ----
# App credentials from https://account.upstox.com/developer/apps. Then open http://localhost:5000/upstox/login each morning.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:5000/upstox/callback
# Filled in automatically by /upstox/login. It expires around 03:30 IST every day.
UPSTOX_ACCESS_TOKEN=
# Optional: JSON file of {"RELIANCE": "NSE_EQ|INE002A01018", ...}. If empty, the server downloads
# Upstox's public NSE instrument master once a day and builds the map itself.
UPSTOX_INSTRUMENT_MAP_FILE=

# ---- Paper trading rules ----
# Free headline feeds for the scanner and stock pages (Google News RSS)
NEWS_ENABLED=true

STARTING_BALANCE=100000
# Intraday (MIS) leverage: margin required = order value / MIS_LEVERAGE
MIS_LEVERAGE=5
MAX_ORDER_QTY=100000
